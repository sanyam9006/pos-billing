{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_|^next$" }],
    "no-console": "off",
    "semi": ["error", "always"],
    "eqeqeq": "warn",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "overrides": [
    {
      "files": ["client/**/*.{js,jsx}"],
      "env": { "browser": true },
      "parserOptions": { "ecmaFeatures": { "jsx": true } }
    }
  ]
}
