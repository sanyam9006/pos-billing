{
  "name": "pos-billing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "seed": "node server/seed.js",
    "seed:demo": "node server/seed-demo.js",
    "build": "cd client && npm run build",
    "setup": "npm install && cd client && npm install && cd .. && npm run seed",
    "lint": "eslint server/",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.{js,jsx,css}\"",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0"
  }
}
